# ---------- Модель: заполни ОДИН из двух вариантов ----------
# Вариант А — OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
MODEL=z-ai/glm-5.3-flash

# Вариант Б — Azure (AI Foundry / Azure OpenAI). Убери # у трёх строк ниже и заполни их,
# а в MODEL выше впиши имя деплоя модели. В AZURE_ENDPOINT можно вставить и Target URI из портала целиком.
# LLM_PROVIDER=azure
# AZURE_ENDPOINT=https://<ресурс>.services.ai.azure.com/models
# AZURE_API_KEY=

# OCR — распознавание текста с фото и сканов (Mistral Document AI в Azure). Нужен, если модель не видит
# картинки (DeepSeek). Ключ берётся тот же, что AZURE_API_KEY; OCR_MODEL — имя деплоя OCR.
# AZURE_OCR_ENDPOINT=https://<ресурс>.services.ai.azure.com/providers/mistral/azure/ocr
# OCR_MODEL=mistral-document-ai-2512
# Видит ли модель картинки: для DeepSeek по умолчанию false, для остальных true
# LLM_VISION=false

# Пароль от веб-офиса. Если пусто — при каждом запуске генерируется новый и печатается в лог
ADMIN_PASSWORD=
# Внешний адрес офиса, например https://algo-office.fly.dev
PUBLIC_URL=http://localhost:8080
PORT=8080
# Папка для данных и рабочего пространства агентов
DATA_DIR=./data

# Канал с Саней (личный ассистент, отдельное приложение): поручения и передача доступов
AGENT_LINK_TOKEN=
SANYA_URL=

# Путь к ffmpeg, если он не в PATH
FFMPEG_PATH=
